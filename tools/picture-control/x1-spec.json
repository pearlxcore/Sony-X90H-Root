 "generated": "2026-11-17",
 "summary": "Machine-readable control surface for the Sony X1 / MT5895 picture path. The complete set of settable picture settings (all g_video__ config keys), each with its exact range, default and group, discovered read-only via MtkTvConfig.getMinMaxConfigValue / getConfigValue / getConfigDefaultValue. Input-agnostic: settings are per input.",
 "scope_note": "These keys control SONY'S picture path for the ACTIVE INPUT (any HDMI/source, not specific to one console). Settings are per-input and persist (Sony's own setConfigValue). Reality Creation / MotionFlow / NR run on Sony's MediaTek silicon; a GPU overlay would bypass them. Ranges/defaults are from a live read-only sweep on this firmware; a value of max==0 (e.g. allm_mode on a 480i input) means the control is unavailable on that input/signal. meta_readonly keys are version fields, not controls.",
 "device": {
  "model": "Sony KD-55X9000H (BRAVIA_VH1, MT5895 / X1)",
  "android": 12,
  "firmware_fingerprint": "Sony/BRAVIA_VH1_PA/BRAVIA_VH1:12/STT2.230505.001.S137/626241:user/release-keys",
  "dtv_driver_ko_sha256": "97738790f18837a41cc1fad9da11657210b5462d29882e272928a8187f9b7125",
  "note": "This control surface MUST verify firmware_fingerprint and dtv_driver_ko_sha256 before acting. All addresses/offsets/struct layouts below are valid ONLY for this fingerprint+hash. On a mismatch, refuse."
 },
 "preconditions": {
  "root": "prod_exploit_v21 keeper running (uid 0, u:r:init:s0), reached via the mailbox /data/local/tests/x90cmd. Per-boot; ~2 min after a reboot.",
  "input": "Picture settings are PER INPUT; confirm the SOURCE line of a snapshot and use the inputGroup argument (-1 = active input) to target a specific input.",
  "signal_for_latency": "Latency measurement needs an active signal on HDMI4 (VERIFIED_480I for the PS2 480i60 case)."
 },
 "safety": {
  "never_touch": [
   "perm partition (DRM: widevine/playready/netflix) - not even read",
   "TEE/TrustZone/keymaster/RPMB",
   "firmware signing",
   "EEPROM raw writes"
  ],
  "forbidden_commands": [
   "sopq.prxy.cust_function.get_all (reboots the TV)",
   "bare recursive ls/grep/find as root (wedges the single-threaded keeper)"
  ],
  "discipline": "Every change: snapshot -> set -> (measure) -> restore -> verify the 20-key snapshot is byte-identical. The CLI does this automatically for temporary/measure paths.",
  "reversible_tiers": {
   "config": "setConfigValue keys below - safe, official, persistent, individually reversible.",
   "runtime_module": "x90mjcg.ko hybrid - loads stock-function-calling kernel code; reversible but advanced. Marked tier=advanced."
  }
 },
 "control_paths": {
  "persistent": {
   "how": "com.mediatek.twoworlds.tv.MtkTvConfig.setConfigValue(key, value)  (isUpdate=3). Exactly the call Sony's own settings UI makes.",
   "effect": "Writes eeprom_A immediately; survives reboot. Proven across a reboot 2026-11-16.",
   "device_recipe": "runcon u:r:sony_platform_app:s0:c512,c768 env -u LD_LIBRARY_PATH CLASSPATH=/data/local/tests/pqset.dex:/vendor/framework/com.mediatek.twoworlds.tv.jar timeout 25 app_process /system/bin PQSetOnce <key> <value>",
   "per_slot": "Writes the slot for the CURRENT input AND current picture mode. Setting a key while in Game edits Game's slot."
  },
  "read": {
   "pq_snapshot": "runcon u:r:sony_platform_app:s0:c512,c768 env LD_LIBRARY_PATH=/vendor/lib:/system/lib /data/local/tests/x90-pq-hdmi4-orig snapshot  (20 keys + SOURCE + SIGNAL)",
   "engine_struct": "/data/local/tests/mtalc 'sopq.prxy.ui.pic'  then dmesg  (full CUST_PIC_SETTING_T)",
   "frame_delay": "/data/local/tests/mtalc 'sopq.prxy.api.oth.frmdly'  then dmesg  -> 'GetVideoFrameDelay: MCVP=<di> SCL=<scaler> MJC=<memc>' in x10 frames"
  },
  "runtime_only_avoid": {
   "ioctl_0x200fe": "x90cust set 0x200fe 112 <hex> writes the whole struct into BEPQ. RAM-only, bypasses Sony's store, can desync engine from the official values. Experiments only; never for presets.",
   "calibration_api": "Sony PictureQualityController (ACTION_BIND_PICTURE_QUALITY_CONTROL) is gated by a Sony whitelist + trusted-cert check. NOT usable by the debug-signed Toolbox."
  }
 },
